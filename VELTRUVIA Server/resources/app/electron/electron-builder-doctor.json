{
  "appId": "com.veltruvia.doctor",
  "productName": "VELTRUVIA Doctor",
  "publish": {
    "provider": "github",
    "owner": "videju",
    "repo": "veltruvia"
  },
  "directories": {
    "output": "dist-desktop"
  },
  "files": [
    "src/**/*",
    "public/**/*",
    "!public/downloads/**/*",
    "electron/**/*",
    "package.json",
    "node_modules/**/*",
    "!node_modules/**/{test,__tests__,tests,spec,__mocks__,example,examples,docs,doc,bench,benchmark,benchmarks}/**",
    "!node_modules/**/*.{md,markdown,map,ts,tsx,flow,d.ts,spec.js,test.js}",
    "!node_modules/**/*.tsbuildinfo",
    "!node_modules/**/{.github,.vscode,.idea,__pycache__,.travis.yml,tsconfig.json,tslint.json,.eslintrc,.babelrc,Gruntfile.js,Makefile}"
  ],
  "extraMetadata": {
    "main": "electron/main-doctor.js"
  },
  "extraResources": [
    {
      "from": "node_modules/sql.js/dist",
      "to": "sql.js"
    },
    {
      "from": "node_modules/electron/dist/ffmpeg.dll",
      "to": "ffmpeg.dll"
    }
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/icons/veltruvia.ico"
  },
  "mac": {
    "target": "dmg",
    "category": "public.app-category.medical"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "icon": "public/icons/veltruvia.ico",
    "category": "Medical"
  },
  "asarUnpack": [
    "node_modules/**/*.node"
  ],
  "compression": "maximum",
  "electronLanguages": [
    "en-US"
  ],
  "electronVersion": "35.7.5"
}
