# Dependencies (each bundle carries its own; never commit)
node_modules/

# Runtime databases (real patient data never belongs in git)
*.db
*.db-wal
*.db-shm
test.db
test-verify.db*
*.sqlite

# Generated demo credential file (only exists when VELTRUVIA_DEMO=true)
.demo-admin-password

# Runtime stores and logs
data/
*.log
verify-server.log
verify-tests.log
dbg*.log

# PHI runtime stores (never commit patient data; normally live in data/,
# but the verifier or a misconfigured relative DB_PATH can drop them in bundle roots)
VELTRUVIA*/resources/app/patient-store.json
VELTRUVIA*/resources/app/*-store.json
VELTRUVIA*/resources/app/telehealth-*.json
VELTRUVIA*/resources/app/chain.json

# Build outputs
dist-desktop/
dist/

# Mobile (Capacitor) build artifacts — www/ is generated by npm run apk:*
# and android/ is generated by `npx cap add android` on each dev machine.
# node_modules above already covers mobile/*/node_modules.
mobile/*/www/
mobile/*/android/
mobile/*/node_modules/

# APK signing secrets — the keystore IS the app's identity; losing it means
# never being able to update the app. Back both of these up somewhere safe.
veltruvia-release.keystore
.keystore-pass

# Electron runtime binaries (rebuildable, huge — not source)
VELTRUVIA Server/*.dll
VELTRUVIA Server/*.pak
VELTRUVIA Server/*.bin
VELTRUVIA Server/*.dat
VELTRUVIA Server/*.json
VELTRUVIA Server/locales/
VELTRUVIA Server/LICENSES.chromium.html
VELTRUVIA Server/LICENSE.electron.txt
VELTRUVIA Server/VELTRUVIA Server.exe
VELTRUVIA Doctor/*.dll
VELTRUVIA Doctor/*.pak
VELTRUVIA Doctor/*.bin
VELTRUVIA Doctor/*.dat
VELTRUVIA Doctor/*.json
VELTRUVIA Doctor/locales/
VELTRUVIA Doctor/LICENSES.chromium.html
VELTRUVIA Doctor/LICENSE.electron.txt
VELTRUVIA Doctor/VELTRUVIA Doctor.exe
VELTRUVIA Patient/*.dll
VELTRUVIA Patient/*.pak
VELTRUVIA Patient/*.bin
VELTRUVIA Patient/*.dat
VELTRUVIA Patient/*.json
VELTRUVIA Patient/locales/
VELTRUVIA Patient/LICENSES.chromium.html
VELTRUVIA Patient/LICENSE.electron.txt
VELTRUVIA Patient/VELTRUVIA Patient.exe
VELTRUVIA Lab/*.dll
VELTRUVIA Lab/*.pak
VELTRUVIA Lab/*.bin
VELTRUVIA Lab/*.dat
VELTRUVIA Lab/*.json
VELTRUVIA Lab/locales/
VELTRUVIA Lab/LICENSES.chromium.html
VELTRUVIA Lab/LICENSE.electron.txt
VELTRUVIA Lab/VELTRUVIA Lab.exe

# Secrets — NEVER commit
.env

# Runtime shared config (server discovery state)
config/

# Download-page copies of built binaries — refreshed from dist/ on deploy,
# never source. (Keeps the repo small and out of GitHub's 100 MB limit.)
VELTRUVIA*/resources/app/public/downloads/*.exe
VELTRUVIA*/resources/app/public/downloads/*.apk

# Editor backup leftovers
*.bak

# Lock files from crashed/held DB probes
*.db.lock

# Process-id scratch files
*.pid

# One-off debug scripts
_veltruvia/

# OS / editor noise
Thumbs.db
.DS_Store

# Stray portable-exe duplicates in the Server bundle root (deploy artifacts)
VELTRUVIA Server/VELTRUVIA Doctor.exe

# Test-run runtime store (recreated by npm test)
hardening-tmp/

# Windows code-signing secrets (self-signed placeholder cert)
veltruvia-codesign.pfx
.codesign-pfx-pass

# Offline download mirror is machine-local (binaries live in dist/)
"VELTRUVIA Server/resources/app/public/downloads/"

# LAN TLS private key — never commit
config/tls/

# local-only secret vaults & rotation artifacts
keys.vault.bin
.env.pre-rotation-*
# in-app artifact mirror (large binaries, refreshed locally)
VELTRUVIA Server/resources/app/public/downloads/

# per-app download mirrors (large binaries, refreshed locally)
VELTRUVIA Doctor/resources/app/public/downloads/
VELTRUVIA Patient/resources/app/public/downloads/
VELTRUVIA Lab/resources/app/public/downloads/

# ── Secrets & backups (never commit) ──
.env.pre-email-backup
.env*
!contracts/.env.example
veltruvia-codesign.cer
*.asar.backup
runtime-shell-*-backup/
.freebuff/vm-debug-users.mjs
