# Email Configuration — Pick ONE provider below.
# Copy this file to .env and fill in your credentials.

# ── Option 1: Resend (RECOMMENDED — works on Vercel/serverless) ────
# Free at https://resend.com — 100 emails/day, 3000/month
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM=VELTRUVIA <onboarding@resend.dev>

# ── Option 2: Gmail App Password ───────────────────────────────────
# Google Account → Security → 2-Step Verification → App passwords
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Option 3: Generic SMTP ─────────────────────────────────────────
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your_user
# SMTP_PASS=your_password
# SMTP_FROM=VELTRUVIA <no-reply@yourdomain.com>

# ── Twilio SMS (optional — for password change OTP delivery) ───────
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=xxxxx
# TWILIO_FROM=+1234567890

# ── App secrets (auto-generated in dev mode) ──────────────────────
# JWT_SECRET=your_jwt_secret
# PHI_ENCRYPTION_KEY=your_64_char_hex_key_or_longer_string

# ── Database ──────────────────────────────────────────────────────
# DB_PATH=./chemocure.db
# DB_EPHEMERAL=true
