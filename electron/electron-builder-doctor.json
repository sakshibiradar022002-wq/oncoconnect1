{
  "appId": "com.oncoconnect.doctor",
  "productName": "OncoConnect Doctor",
  "directories": {
    "output": "dist-desktop"
  },
  "files": [
    "src/**/*",
    "public/**/*",
    "electron/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main-doctor.js"
  },
  "extraResources": [
    {
      "from": "node_modules/sql.js/dist",
      "to": "sql.js"
    }
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "mac": {
    "target": "dmg",
    "category": "public.app-category.medical"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "icon": "public/icons/doctor-512.png",
    "category": "Medical"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "OncoConnect Doctor"
  }
}