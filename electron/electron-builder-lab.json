{
  "appId": "com.oncoconnect.lab",
  "productName": "OncoConnect Lab",
  "directories": {
    "output": "dist-desktop"
  },
  "files": [
    "src/**/*",
    "public/**/*",
    "electron/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main-lab.js"
  },
  "extraResources": [
    {
      "from": "node_modules/sql.js/dist",
      "to": "sql.js"
    }
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/icons/lab-512.png"
  },
  "mac": {
    "target": "dmg",
    "category": "public.app-category.medical"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "icon": "public/icons/lab-512.png",
    "category": "Medical"
  }
}