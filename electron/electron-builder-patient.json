{
  "appId": "com.oncoconnect.patient",
  "productName": "OncoConnect Patient",
  "directories": {
    "output": "dist-desktop"
  },
  "files": [
    "src/**/*",
    "public/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main-patient.js"
  },
  "extraResources": [
    {
      "from": "node_modules/sql.js/dist",
      "to": "sql.js"
    }
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icons/patient-512.png"
  },
  "mac": {
    "target": "dmg",
    "icon": "public/icons/patient-512.png",
    "category": "public.app-category.medical"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "public/icons/patient-512.png",
    "category": "Medical"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "public/icons/patient-512.png",
    "uninstallerIcon": "public/icons/patient-512.png",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "OncoConnect Patient",
    "installerHeaderIcon": "public/icons/patient-512.png"
  }
}
