{
  "name": "veltruvia-suite",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "VELTRUVIA neuro-oncology EMR desktop suite — quality gate, verification, and docs",
  "scripts": {
    "check": "node check.mjs",
    "test": "node --test --test-force-exit tests/",
    "verify": "node scripts/verify-all.mjs",
    "verify:server": "node scripts/verify-app.mjs \"VELTRUVIA Server/resources/app\" Server",
    "verify:doctor": "node scripts/verify-app.mjs \"VELTRUVIA Doctor/resources/app\" Doctor",
    "verify:patient": "node scripts/verify-app.mjs \"VELTRUVIA Patient/resources/app\" Patient",
    "verify:lab": "node scripts/verify-app.mjs \"VELTRUVIA Lab/resources/app\" Lab",
    "sync-bundles": "node sync-bundles.mjs",
    "apk:patient": "node scripts/build-apk.mjs patient",
    "apk:lab": "node scripts/build-apk.mjs lab",
    "precommit": "npm run check && npm run test && npm run verify"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  }
}
