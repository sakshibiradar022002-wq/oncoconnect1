{
  "name": "veltruvia-suite",
  "version": "2.6.6",
  "private": true,
  "type": "module",
  "description": "VELTRUVIA neuro-oncology EMR desktop suite — quality gate, verification, and docs",
  "scripts": {
    "check": "node check.mjs",
    "test": "node --test --test-force-exit tests/",
    "verify": "node scripts/verify-all.mjs",
    "verify:server": "node scripts/verify-app.mjs \"VELTRUVIA Server/resources/app\" Server",
    "verify:doctor": "node scripts/verify-app.mjs \"VELTRUVIA Doctor/resources/app\" Doctor",
    "verify:patient": "node scripts/verify-app.mjs \"VELTRUVIA Patient/resources/app\" Patient",
    "verify:lab": "node scripts/verify-app.mjs \"VELTRUVIA Lab/resources/app\" Lab",
    "sync-bundles": "node sync-bundles.mjs",
    "guard": "node scripts/guard-canonical.mjs --all",
    "hooks:install": "node scripts/install-hooks.mjs",
    "drug-labels": "node scripts/enrich-drug-labels.mjs --names=contracts/drug-labels-extra.txt",
    "audit:cui": "node scripts/audit-rxnorm-cui.mjs",
    "pentest:zap": "bash scripts/pentest/zap-scan.sh",
    "pentest:http": "node scripts/pentest/http-audit.mjs",
    "audit:anomaly": "node scripts/audit-anomaly.mjs",
    "backup:offsite": "node scripts/offsite-backup.mjs",
    "imaging:seed": "node scripts/seed-imaging.mjs",
    "uptime:ping": "node scripts/uptime-heartbeat.mjs",
    "apk:patient": "node scripts/build-apk.mjs patient",
    "apk:lab": "node scripts/build-apk.mjs lab",
    "precommit": "npm run guard && npm run check && npm run test && npm run verify"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  }
}
