# Copy this file to .env and fill in your own values (never commit .env!)
# See README.md for the full walkthrough.

# Private key of the anchor wallet (testnet-only wallet recommended).
# Generate a fresh one locally:  node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
ANCHOR_PRIVATE_KEY=0xYourTestnetWalletPrivateKey

# Free public Sepolia RPC (default; an Alchemy/Infura free key is more reliable)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
